{
  "manifest_version": 3,
  "name": "🔍 Smart Contract Token Checker – ERC20 Inspector",
  "version": "3.0.0",
  "description": "Advanced multi-chain token inspector with comprehensive analysis. Support for Ethereum, Polygon, BSC with market data, holders analysis, and contract details. Beautiful dark UI with golden accents.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://cloudflare-eth.com/*",
    "https://ethereum.publicnode.com/*",
    "https://rpc.ankr.com/*",
    "https://eth.llamarpc.com/*",
    "https://ethereum-rpc.publicnode.com/*",
    "https://ethereum.blockpi.network/*",
    "https://eth.merkle.io/*",
    "https://rpc.payload.de/*",
    "https://eth.drpc.org/*",
    "https://rpc.flashbots.net/*",
    "https://polygon-rpc.com/*",
    "https://bsc-dataseed.binance.org/*",
    "https://api.coingecko.com/*",
    "https://assets.coingecko.com/*",
    "https://etherscan.io/*",
    "https://polygonscan.com/*",
    "https://bscscan.com/*",
    "https://mempool.space/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ERC20 Token Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fullpage.html", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "author": "Mohammad Nasser Haji hashemabad (Nasser Hashemabadi)",
  "homepage_url": "https://github.com/naserhha/smart-contract-token-checker"
}
